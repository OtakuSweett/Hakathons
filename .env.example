# NASA Earthdata token — required for AppEEARS SMAP/NDVI authenticated downloads
# Get yours at: https://urs.earthdata.nasa.gov/users/new
# NEVER commit the real .env file — it is in .gitignore
EARTHDATA_TOKEN=

# Service ports
PORT_ORCHESTRATOR=3000
PORT_PHYSICS_WORKER=8001
PORT_OPTIMIZER_WORKER=8002
PORT_WEB=5173
