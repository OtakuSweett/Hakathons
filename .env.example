# ==============================================================================
# NASA Space Apps 2026 — Global Crop Rotation & Water Resilience DSS
# Environment Configuration (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Configure variables as needed. All external APIs have offline fallbacks in data/presets/
# ==============================================================================

# --- NASA Earthdata & APIs Configuration ---
# Optional token for authenticated NASA AppEEARS NDVI/SMAP downloads.
# Register and get your token at: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_TOKEN=eyJ0eXAiOiJKV1QiLCJvcmlnaW4iOiJFYXJ0aGRhdGEgTG9naW4iLCJhbGciOiJSUzI1NiJ9...

# External Planetary APIs (Default live endpoints, no API key required)
NASA_POWER_API_URL=https://power.larc.nasa.gov/api
ISRIC_SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0
NASA_EONET_API_URL=https://eonet.gsfc.nasa.gov/api/v3
NASA_GIBS_WMTS_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best

# --- Monorepo Microservices Architecture Ports ---
# Track A: Fastify Orchestrator Gateway API
PORT_ORCHESTRATOR=3000
HOST_ORCHESTRATOR=0.0.0.0

# Track B: Physics Worker (FastAPI: Splines, GDD, RK4, Newton-Raphson)
PORT_PHYSICS_WORKER=8001
PHYSICS_WORKER_URL=http://localhost:8001

# Track C: Optimizer Worker (FastAPI: Pre-solver, HiGHS MILP, Dual Pareto)
PORT_OPTIMIZER_WORKER=8002
OPTIMIZER_WORKER_URL=http://localhost:8002

# Track D: Frontend Web Dashboard (React 19 + Tailwind v4 + Leaflet)
PORT_WEB=5173
VITE_ORCHESTRATOR_URL=http://localhost:3000

# --- Runtime & Simulation Flags ---
# Set to 'live' for real satellite queries; 'preset' forces offline benchmark mode
DEFAULT_DATA_SOURCE=live

# Solver time limit in seconds for HiGHS MILP
SOLVER_TIME_LIMIT_SECONDS=30
