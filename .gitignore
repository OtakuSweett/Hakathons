# Runtime cache (keep data/presets — it has committed JSON)
data/cache/*
!data/cache/.gitkeep
**/data/cache/*

# Build outputs
dist/
build/
.turbo/

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# OS & Temp
.DS_Store
Thumbs.db
*.tmp
*.temp

# Lockfiles ARE committed (pnpm-lock.yaml, uv.lock)
# node_modules and .venv are NOT
